<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Pulse.TestApp.ViewModels"
             x:Class="Pulse.TestApp.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="Pulse Orders">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <!-- Filter row: status + region dropdowns and the live count badge. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Picker ItemsSource="{Binding Statuses}"
                    SelectedItem="{Binding SelectedStatus}"
                    Title="Status" />
            <Picker Grid.Column="1" ItemsSource="{Binding Regions}"
                    SelectedItem="{Binding SelectedRegion}"
                    Title="Region" />
            <Label Grid.Column="2"
                   Text="{Binding CountBadge}"
                   VerticalOptions="Center"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
        </Grid>

        <!-- List: tapping a row opens the detail screen. -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Rows}"
                        SelectionMode="Single"
                        SelectionChanged="OnOrderSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:OrderRowViewModel">
                    <Grid Padding="4,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding CustomerName}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding Region, StringFormat='{0} · {1:C}'}"
                               FontSize="12" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Status}" VerticalOptions="Center"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Status bar: connection state (offline / connecting / connected / reconnecting). -->
        <Border Grid.Row="3" Padding="12,6"
                Stroke="{StaticResource Primary}" StrokeThickness="0"
                BackgroundColor="#E8F0FE" StrokeShape="RoundRectangle 8">
            <Label Text="{Binding ConnectionState}"
                   TextColor="{StaticResource Primary}" FontSize="12" />
        </Border>
    </Grid>

</ContentPage>
